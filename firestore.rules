rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can view the site. Only the owner's Google account can change it.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'danielmcordeiro06@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
